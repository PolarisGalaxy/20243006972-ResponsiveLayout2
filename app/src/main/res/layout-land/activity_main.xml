<?xml version="1.0" encoding="utf-8"?>
<!--
    Part 1: Orientation Qualifier (Landscape)

    This layout is automatically loaded when the device is rotated to landscape.
    It takes advantage of the wider horizontal screen space by arranging the
    UI into a two-pane layout:
      - Left pane : header, subheader, and main description text
      - Right pane: info text on top, action buttons at the bottom

    The root is a LinearLayout (horizontal). Inner LinearLayouts use layout_weight
    to distribute the available horizontal space proportionally.

    No hard-coded pixel dimensions are used - all sizes are 0dp with weights,
    match_parent, wrap_content, or dp/sp units.

    Author: Guo Yuqi
    Student ID: 20243006972
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- =========================================================
         LEFT PANE - Title and description area (takes 3/5 of width)
         ========================================================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <!-- Header TextView -->
        <TextView
            android:id="@+id/text_header"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center"
            android:text="@string/text_header"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700"
            android:padding="8dp" />

        <!-- Subheader TextView -->
        <TextView
            android:id="@+id/text_subheader"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/text_subheader"
            android:textSize="20sp"
            android:textColor="@color/purple_500"
            android:padding="8dp" />

        <!-- Description TextView - more space in landscape -->
        <TextView
            android:id="@+id/text_description"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:gravity="center"
            android:text="@string/text_description"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:padding="8dp" />

    </LinearLayout>

    <!-- =========================================================
         RIGHT PANE - Info text and action buttons (takes 2/5 of width)
         ========================================================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <!-- Info TextView - takes most of the vertical space -->
        <TextView
            android:id="@+id/text_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:gravity="center"
            android:text="@string/text_info"
            android:textSize="16sp"
            android:textColor="@color/teal_700"
            android:padding="8dp" />

        <!-- Buttons container - horizontal layout, side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp">

            <!-- Change Button -->
            <Button
                android:id="@+id/button_change"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/button_change"
                android:backgroundTint="@color/purple_500"
                android:textColor="@color/white" />

            <!-- Cancel Button -->
            <Button
                android:id="@+id/button_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/button_cancel"
                android:backgroundTint="@color/teal_700"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>